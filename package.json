{
  "name": "zura",
  "version": "0.0.4",
  "description": "ZuraAI",
  "author": "Nikhil",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/solnikhil/ZuraAI.git"
  },
  "bugs": {
    "url": "https://github.com/solnikhil/ZuraAI/issues"
  },
  "homepage": "https://github.com/solnikhil/ZuraAI#readme",
  "engines": {
    "node": ">=18",
    "bun": ">=1.1"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:renderer": "tsc && vite build",
    "generate-icons": "bun scripts/generate-icons.mjs",
    "build": "bun scripts/generate-icons.mjs && tsc && vite build && electron-builder",
    "build:dir": "bun scripts/generate-icons.mjs && tsc && vite build && electron-builder --dir",
    "verify:mcp-release": "bun scripts/verify-mcp-release.mjs",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "knip": "knip"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "duck-duck-scrape": "^2.2.7",
    "electron-updater": "^6.7.3",
    "framer-motion": "^12.35.1",
    "lucide-react": "^1.7.0",
    "mermaid": "^11.12.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.12.0",
    "react-syntax-highlighter": "^16.1.0",
    "react-virtuoso": "^4.18.1",
    "recharts": "^3.7.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.0.18",
    "electron": "^41.1.0",
    "electron-builder": "^26.5.0",
    "electron-devtools-installer": "^4.0.0",
    "fast-check": "^4.5.3",
    "jsdom": "^29.0.1",
    "knip": "^6.0.6",
    "png-to-ico": "^3.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "in.zuraai.desktop",
    "productName": "ZuraAI",
    "executableName": "ZuraAI",
    "copyright": "Copyright (c) 2026 Nikhil",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "solnikhil",
      "repo": "ZuraAI",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "ZuraAI",
      "publisherName": "Nikhil",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZuraAI",
      "uninstallDisplayName": "ZuraAI",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/sidebar.bmp",
      "uninstallerSidebar": "build/sidebar.bmp",
      "include": "installer/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "artifactName": "ZuraAI-Setup-${version}.${ext}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
