{
  "name": "zura",
  "version": "0.0.8",
  "private": true,
  "description": "ZuraAI",
  "author": "Nikhil",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/solnikhil/ZuraAI.git"
  },
  "bugs": {
    "url": "https://github.com/solnikhil/ZuraAI/issues"
  },
  "homepage": "https://github.com/solnikhil/ZuraAI#readme",
  "engines": {
    "node": ">=18",
    "bun": ">=1.3.14 <1.4.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && bun run --cwd packages/provider-core typecheck",
    "build:provider-core": "bun run --cwd packages/provider-core build",
    "build:renderer": "bun run build:provider-core && tsc && vite build",
    "generate-icons": "bun scripts/generate-icons.mjs",
    "build": "bun scripts/generate-icons.mjs && bun run build:provider-core && tsc && vite build && electron-builder --publish never && bun scripts/generate-release-checksums.mjs",
    "build:dir": "bun scripts/generate-icons.mjs && bun run build:provider-core && tsc && vite build && electron-builder --dir",
    "build:mac": "bun scripts/generate-icons.mjs && bun run build:provider-core && tsc && vite build && electron-builder --mac --publish never && bun scripts/generate-release-checksums.mjs",
    "build:mac:dir": "bun scripts/generate-icons.mjs && bun run build:provider-core && tsc && vite build && electron-builder --mac --dir",
    "release:checksums": "bun scripts/generate-release-checksums.mjs",
    "verify:mcp-release": "bun scripts/verify-mcp-release.mjs",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "trailer:studio": "remotion studio remotion/index.ts",
    "trailer:render": "remotion render remotion/index.ts ZuraAI-Trailer out/zuraai-trailer.mp4",
    "trailer:still": "remotion still remotion/index.ts ZuraAI-Trailer out/zuraai-trailer-frame.png --frame=194 --scale=0.5",
    "memory:scenario": "bun scripts/memory-scenario.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.15",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "^1.1.16",
    "@radix-ui/react-collapsible": "^1.1.13",
    "@radix-ui/react-context-menu": "^2.3.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-menubar": "^1.1.18",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.9",
    "ai": "7.0.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "eventsource-parser": "3.1.0",
    "framer-motion": "^12.35.1",
    "mermaid": "^11.16.0",
    "picocolors": "^1.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "react-syntax-highlighter": "^16.1.0",
    "react-virtuoso": "^4.18.1",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@remotion/cli": "^4.0.484",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^41.1.0",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "eslint": "^10.4.0",
    "fast-check": "^4.5.3",
    "jsdom": "26.1.0",
    "knip": "^6.0.6",
    "png-to-ico": "^3.0.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.4.2",
    "remotion": "^4.0.484",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.1.3",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "brace-expansion": "5.0.7",
    "dompurify": "3.4.11",
    "form-data": "4.0.6",
    "js-yaml": "5.2.1",
    "tar": "7.5.19",
    "tmp": "0.2.7",
    "undici": "6.27.0",
    "uuid": "11.1.1"
  },
  "build": {
    "appId": "in.zuraai.desktop",
    "productName": "ZuraAI",
    "executableName": "ZuraAI",
    "copyright": "Copyright (c) 2026 Nikhil",
    "asar": true,
    "npmRebuild": false,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "solnikhil",
      "repo": "ZuraAI",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "ZuraAI",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "ZuraAI-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDisplayName": "ZuraAI",
        "NSHighResolutionCapable": true
      }
    },
    "dmg": {
      "artifactName": "ZuraAI-${version}-mac-${arch}.${ext}"
    },
    "protocols": [
      {
        "name": "ZuraAI Chat Link",
        "schemes": [
          "zura-chat"
        ]
      },
      {
        "name": "ZuraAI App Launcher",
        "schemes": [
          "zuraai"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZuraAI",
      "uninstallDisplayName": "ZuraAI",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/sidebar.bmp",
      "uninstallerSidebar": "build/sidebar.bmp",
      "include": "installer/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "artifactName": "ZuraAI-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ZuraAI-Portable-${version}-${arch}.${ext}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/*.map",
      "!**/*.test.*",
      "!**/*.spec.*",
      "!**/*.d.ts",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**"
    ]
  }
}
