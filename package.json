{
  "name": "zura",
  "version": "1.0.0",
  "description": "Zura AI - Desktop AI Assistant",
  "author": "Nikhil",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:dir": "tsc && vite build && electron-builder --dir",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.559.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.10.1",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^25.9.8",
    "electron-builder": "^24.0.0",
    "typescript": "^5.0.0",
    "vite": "^4.0.0",
    "vite-plugin-electron": "^0.12.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  },
  "build": {
    "appId": "com.zura.ai",
    "productName": "Zura",
    "executableName": "Zura",
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.png",
      "executableName": "Zura"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Zura"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}