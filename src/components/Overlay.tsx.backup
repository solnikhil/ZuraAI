import React, { useState, useEffect, useRef } from 'react'
import './Overlay.css'

interface Message {
    id: string
    role: 'user' | 'assistant'
    content: string
    image?: string
}

export default function Overlay() {
    const [selection, setSelection] = useState<{ x: number; y: number; width: number; height: number } | null>(null)
    const [isDragging, setIsDragging] = useState(false)
    const [startPos, setStartPos] = useState<{ x: number; y: number } | null>(null)
    const [prompt, setPrompt] = useState('')

    // Chat State
    const [isChatActive, setIsChatActive] = useState(false)
    const [messages, setMessages] = useState<Message[]>([])
    const [isLoading, setIsLoading] = useState(false)
    const messagesEndRef = useRef<HTMLDivElement>(null)

    // Drag and Resize State
    const [chatPosition, setChatPosition] = useState({ x: 0, y: 0 })
    const [chatSize, setChatSize] = useState({ width: 400, height: 500 })
    const [isDraggingChat, setIsDraggingChat] = useState(false)
    const [isResizing, setIsResizing] = useState(false)
    const [dragStart, setDragStart] = useState({ x: 0, y: 0 })
    const [resizeStart, setResizeStart] = useState({ x: 0, y: 0, width: 0, height: 0 })

    useEffect(() => {
        const handleKeyDown = (e: KeyboardEvent) => {
            if (e.key === 'Escape') {
                window.ipcRenderer.send('close-overlay')
            }
        }
        window.addEventListener('keydown', handleKeyDown)
        return () => window.removeEventListener('keydown', handleKeyDown)
    }, [])

    // Listen for the response start event from main process
    useEffect(() => {
        const handleAIResponseStart = (_event: any, { prompt, image }: { prompt: string, image: string }) => {
            setIsChatActive(true)

            // Add user message
            const userMessage: Message = {
                id: Date.now().toString(),
                role: 'user',
                content: prompt,
                image: image
            }
            setMessages([userMessage])

            // Trigger API call
            callOpenRouter(prompt, image)
        }

        const handleResetOverlay = () => {
            setSelection(null)
            setPrompt('')
            setMessages([])
            setIsChatActive(false)
            setIsLoading(false)
            setStartPos(null)
            setIsDragging(false)
        }

        if (window.ipcRenderer) {
            window.ipcRenderer.on('ai-response-start', handleAIResponseStart)
            window.ipcRenderer.on('reset-overlay', handleResetOverlay)
            return () => {
                window.ipcRenderer.off('ai-response-start', handleAIResponseStart)
                window.ipcRenderer.off('reset-overlay', handleResetOverlay)
            }
        }
    }, [])

    const callOpenRouter = async (userPrompt: string, image?: string) => {
        setIsLoading(true)
        try {
            let messagesPayload: any[] = []

            if (image) {
                messagesPayload = [
                    {
                        "role": "user",
                        "content": [
                            { "type": "text", "text": userPrompt },
                            { "type": "image_url", "image_url": { "url": image } }
                        ]
                    }
                ]
            } else {
                messagesPayload = [
                    { "role": "user", "content": userPrompt }
                ]
            }

            const response = await fetch("https://openrouter.ai/api/v1/chat/completions", {
                method: "POST",
                headers: {
                    "Authorization": `Bearer ${import.meta.env.VITE_OPENROUTER_API_KEY}`,
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    "model": "openrouter/sherlock-dash-alpha",
                    "messages": messagesPayload
                })
            });

            const data = await response.json()
            const aiContent = data.choices?.[0]?.message?.content || "Sorry, I couldn't get a response."

            const aiMessage: Message = {
                id: Date.now().toString(),
                role: 'assistant',
                content: aiContent
            }
            setMessages(prev => [...prev, aiMessage])
        } catch (error) {
            console.error("API Error:", error)
            const errorMessage: Message = {
                id: Date.now().toString(),
                role: 'assistant',
                content: "Sorry, there was an error connecting to the AI."
            }
            setMessages(prev => [...prev, errorMessage])
        } finally {
            setIsLoading(false)
        }
    }

    const handleMouseDown = (e: React.MouseEvent) => {
        if (isChatActive) return // Disable selection when chat is active
        if (prompt) return

        // Right click to reset
        if (e.button === 2) {
            setSelection(null)
            setPrompt('')
            return
        }

        setIsDragging(true)
        setStartPos({ x: e.clientX, y: e.clientY })
        setSelection({ x: e.clientX, y: e.clientY, width: 0, height: 0 })
    }

    const handleMouseMove = (e: React.MouseEvent) => {
        if (!isDragging || !startPos) return

        const currentX = e.clientX
        const currentY = e.clientY

        const x = Math.min(startPos.x, currentX)
        const y = Math.min(startPos.y, currentY)
        const width = Math.abs(currentX - startPos.x)
        const height = Math.abs(currentY - startPos.y)

        setSelection({ x, y, width, height })
    }

    const handleMouseUp = () => {
        setIsDragging(false)
    }

    const handleSubmit = (e: React.FormEvent) => {
        e.preventDefault()
        if (!prompt.trim()) return

        if (!isChatActive) {
            // Initial submission
            if (!selection) return
            window.ipcRenderer.send('submit-prompt', {
                prompt,
                selection
            })
            setPrompt('') // Clear prompt, wait for response to set chat active
        } else {
            // Follow-up message
            const userMessage: Message = {
                id: Date.now().toString(),
                role: 'user',
                content: prompt
            }
            setMessages(prev => [...prev, userMessage])
            setPrompt('')

            // For follow-ups, we should ideally send history. 
            // For now, sending the new prompt with the original image context if available.
            const firstMessage = messages[0]
            const image = firstMessage?.image

            callOpenRouter(prompt, image)
        }
    }

    const minimizeOverlay = () => {
        window.ipcRenderer.send('minimize-overlay')
    }

    const closeOverlay = () => {
        window.ipcRenderer.send('close-overlay')
    }

    // Calculate position
    let positionStyle: React.CSSProperties = {}

    if (isChatActive) {
        // Use custom position if dragged, otherwise default to top-center
        if (chatPosition.x !== 0 || chatPosition.y !== 0) {
            positionStyle = {
                position: 'fixed',
                left: chatPosition.x,
                top: chatPosition.y,
                width: chatSize.width,
                height: chatSize.height,
                margin: 0
            }
        } else {
            // Default: Top-center
            const defaultX = (window.innerWidth - chatSize.width) / 2
            const defaultY = 100
            setChatPosition({ x: defaultX, y: defaultY })
            positionStyle = {
                position: 'fixed',
                left: defaultX,
                top: defaultY,
                width: chatSize.width,
                height: chatSize.height,
                margin: 0
            }
        }
    } else if (selection) {
        // Smart positioning for initial prompt box (relative to selection)
        const spaceBelow = window.innerHeight - (selection.y + selection.height)
        const minSpaceNeeded = 500 // Approximate max height of expanded chat

        if (spaceBelow < minSpaceNeeded && selection.y > minSpaceNeeded) {
            // Position above
            positionStyle = {
                left: selection.x,
                bottom: window.innerHeight - selection.y + 10,
                maxHeight: selection.y - 20 // Constrain height if needed
            }
        } else {
            // Position below (default)
            positionStyle = {
                left: selection.x,
                top: selection.y + selection.height + 10,
                maxHeight: window.innerHeight - (selection.y + selection.height) - 20
            }
        }
    }

    // Manage click-through state
    useEffect(() => {
        if (isChatActive) {
            // When chat is active, default to ignoring mouse events (click-through)
            // forward: true is essential to still receive mousemove events to detect hover
            window.ipcRenderer.send('set-ignore-mouse-events', true, { forward: true })
        } else {
            // When selecting, capture everything
            window.ipcRenderer.send('set-ignore-mouse-events', false)
        }
    }, [isChatActive])

    const handleMouseEnterChat = () => {
        if (isChatActive) {
            // When hovering chat, capture mouse events (interactive)
            window.ipcRenderer.send('set-ignore-mouse-events', false)
        }
    }

    const handleMouseLeaveChat = () => {
        if (isChatActive) {
            // When leaving chat, ignore mouse events (click-through)
            window.ipcRenderer.send('set-ignore-mouse-events', true, { forward: true })
        }
    }

    // Chat dragging handlers
    const handleChatMouseDown = (e: React.MouseEvent) => {
        if (!isChatActive) return
        setIsDraggingChat(true)
        setDragStart({
            x: e.clientX - chatPosition.x,
            y: e.clientY - chatPosition.y
        })
    }

    const handleChatDrag = (e: MouseEvent) => {
        if (!isDraggingChat) return
        setChatPosition({
            x: e.clientX - dragStart.x,
            y: e.clientY - dragStart.y
        })
    }

    const handleChatDragEnd = () => {
        setIsDraggingChat(false)
    }

    // Chat resizing handlers
    const handleResizeMouseDown = (e: React.MouseEvent) => {
        e.stopPropagation()
        setIsResizing(true)
        setResizeStart({
            x: e.clientX,
            y: e.clientY,
            width: chatSize.width,
            height: chatSize.height
        })
    }

    const handleResize = (e: MouseEvent) => {
        if (!isResizing) return
        const deltaX = e.clientX - resizeStart.x
        const deltaY = e.clientY - resizeStart.y
        setChatSize({
            width: Math.max(320, resizeStart.width + deltaX),
            height: Math.max(300, resizeStart.height + deltaY)
        })
    }

    const handleResizeEnd = () => {
        setIsResizing(false)
    }

    // Global mouse handlers for dragging and resizing
    useEffect(() => {
        if (isDraggingChat) {
            window.addEventListener('mousemove', handleChatDrag)
            window.addEventListener('mouseup', handleChatDragEnd)
            return () => {
                window.removeEventListener('mousemove', handleChatDrag)
                window.removeEventListener('mouseup', handleChatDragEnd)
            }
        }
    }, [isDraggingChat, dragStart, chatPosition])

    useEffect(() => {
        if (isResizing) {
            window.addEventListener('mousemove', handleResize)
            window.addEventListener('mouseup', handleResizeEnd)
            return () => {
    >
                    {/* Dimmer - Only visible when NO selection is active to prevent double-dimming */ }
                {
                    !selection && !isChatActive && (
                        <div className="dimmer" />
                    )
                }

                {
                    !selection && !isChatActive && (
                        <div className="instruction-text">
                            Click and drag to capture an area
                        </div>
                    )
                }

                {/* Selection Box - Hide when chat is active to clean up UI */ }
                {
                    selection && !isChatActive && (
                        <div
                            className="selection-box"
                            style={{
                                left: selection.x,
                                top: selection.y,
                                width: selection.width,
                                height: selection.height
                            }}
                        />
                    )
                }

                {/* Prompt Box / Chat Panel */ }
                {
                    selection && !isDragging && (selection.width > 10 || selection.height > 10) && (
                        <div
                            className={`prompt-box ${isChatActive ? 'expanded' : ''}`}
                            style={positionStyle}
                            onMouseDown={e => e.stopPropagation()}
                            onMouseEnter={handleMouseEnterChat}
                            onMouseLeave={handleMouseLeaveChat}
                        >
                            {!isChatActive ? (
                                <form onSubmit={handleSubmit}>
                                    <input
                                        autoFocus
                                        type="text"
                                        value={prompt}
                                        onChange={e => setPrompt(e.target.value)}
                                        placeholder="Ask Zura about this..."
                                    />
                                </form>
                            ) : (
                                <div className="chat-panel">
                                    <div
                                        className="chat-header"
                                        onMouseDown={handleChatMouseDown}
                                        style={{ cursor: isDraggingChat ? 'grabbing' : 'grab' }}
                                    >
                                        <span>Zura</span>
                                        <div className="window-controls">
                                            <button onClick={minimizeOverlay} className="minimize-btn" title="Hide Chat">_</button>
                                            <button onClick={closeOverlay} className="close-btn" title="Close Session">×</button>
                                        </div>
                                    </div>
                                    <div className="chat-messages">
                                        {messages.map(msg => (
                                            <div key={msg.id} className={`chat-message ${msg.role}`}>
                                                {msg.role === 'assistant' && <div className="avatar">Z</div>}
                                                <div className="content">{msg.content}</div>
                                            </div>
                                        ))}
                                        {isLoading && <div className="thinking">Thinking...</div>}
                                        <div ref={messagesEndRef} />
                                    </div>
                                    <form onSubmit={handleSubmit} className="chat-input-form">
                                        <input
                                            type="text"
                                            value={prompt}
                                            onChange={e => setPrompt(e.target.value)}
                                            placeholder="How can I help you?"
                                            className="chat-input"
                                            autoFocus
                                        />
                                    </form>
                                    <div
                                        className="resize-handle"
                                        onMouseDown={handleResizeMouseDown}
                                    />
                                </div>
                            )}
                        </div>
                    )
                }
    </div >
)
}
